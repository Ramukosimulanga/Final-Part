import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  StyleSheet,
  Pressable,
  FlatList,
  Alert,
  StatusBar,
} from 'react-native';

import { Picker } from '@react-native-picker/picker';

type MenuItem = {
  id: string;
  dishName: string;
  description: string;
  course: string;
  price: string;
};

export default function HomeScreen() {
  const [screen, setScreen] = useState<'home' | 'add'>('home');

  const [menuItems, setMenuItems] = useState<MenuItem[]>([]);

  const [dishName, setDishName] = useState('');
  const [description, setDescription] = useState('');
  const [course, setCourse] = useState('');
  const [price, setPrice] = useState('');

  const [error, setError] = useState('');

  // Clear the form
  const clearForm = () => {
    setDishName('');
    setDescription('');
    setCourse('');
    setPrice('');
    setError('');
  };

  // Add a new menu item
  const addMenuItem = () => {
    if (dishName.trim() === '') {
      setError('Please enter the dish name.');
      return;
    }

    if (description.trim() === '') {
      setError('Please enter the description.');
      return;
    }

    if (course === '') {
      setError('Please select a course.');
      return;
    }

    if (price.trim() === '') {
      setError('Please enter the price.');
      return;
    }

    const priceNumber = Number(price);

    if (isNaN(priceNumber) || priceNumber <= 0) {
      setError('Please enter a valid price greater than R0.');
      return;
    }

    const newMenuItem: MenuItem = {
      id: Date.now().toString(),
      dishName: dishName.trim(),
      description: description.trim(),
      course: course,
      price: priceNumber.toFixed(2),
    };

    setMenuItems((oldItems) => [
      ...oldItems,
      newMenuItem,
    ]);

    Alert.alert(
      'Menu Item Added',
      `${dishName.trim()} has been successfully added to the menu.`
    );

    clearForm();
    setScreen('home');
  };

  // Display one menu item
  const renderMenuItem = ({
    item,
  }: {
    item: MenuItem;
  }) => {
    return (
      <View style={styles.menuCard}>

        <View style={styles.menuTop}>

          <Text style={styles.dishName}>
            {item.dishName}
          </Text>

          <View style={styles.courseBadge}>
            <Text style={styles.courseText}>
              {item.course}
            </Text>
          </View>

        </View>

        <Text style={styles.description}>
          {item.description}
        </Text>

        <View style={styles.priceRow}>

          <Text style={styles.priceLabel}>
            Price
          </Text>

          <Text style={styles.price}>
            R {item.price}
          </Text>

        </View>

      </View>
    );
  };

  // =====================================================
  // HOME SCREEN
  // =====================================================

  if (screen === 'home') {
    return (
      <View style={styles.container}>

        <StatusBar
          barStyle="light-content"
        />

        {/* HEADER */}

        <View style={styles.header}>

          <Text style={styles.title}>
            Restaurant
          </Text>

          <Text style={styles.titleAccent}>
            Menu Manager
          </Text>

          <Text style={styles.subtitle}>
            Manage your restaurant menu with ease
          </Text>

        </View>

        {/* CONTENT */}

        <View style={styles.content}>

          {/* ADD MENU ITEM BUTTON */}

          <Pressable
            style={styles.addButton}
            onPress={() => {
              clearForm();
              setScreen('add');
            }}
          >

            <Text style={styles.addButtonText}>
              + Add Menu Item
            </Text>

          </Pressable>

          {/* MENU HEADER */}

          <View style={styles.sectionHeader}>

            <Text style={styles.sectionTitle}>
              Menu Items
            </Text>

            <Text style={styles.itemCount}>
              {menuItems.length}{' '}
              {menuItems.length === 1 ? 'item' : 'items'}
            </Text>

          </View>

          {/* EMPTY MENU */}

          {menuItems.length === 0 ? (

            <View style={styles.emptyContainer}>

              <Text style={styles.emptyIcon}>
                🍽️
              </Text>

              <Text style={styles.emptyTitle}>
                No Menu Items Yet
              </Text>

              <Text style={styles.emptyMessage}>
                Add your first menu item to start
                building your restaurant menu.
              </Text>

            </View>

          ) : (

            <FlatList
              data={menuItems}
              keyExtractor={(item) => item.id}
              renderItem={renderMenuItem}
              showsVerticalScrollIndicator={false}
              contentContainerStyle={styles.list}
            />

          )}

        </View>

      </View>
    );
  }

  // =====================================================
  // ADD MENU ITEM SCREEN
  // =====================================================

  return (
    <View style={styles.container}>

      <StatusBar
        barStyle="light-content"
      />

      {/* HEADER */}

      <View style={styles.addHeader}>

        <Pressable
          style={styles.backButton}
          onPress={() => {
            clearForm();
            setScreen('home');
          }}
        >

          <Text style={styles.backText}>
            ‹
          </Text>

        </Pressable>

        <View>

          <Text style={styles.addTitle}>
            Add Menu Item
          </Text>

          <Text style={styles.addSubtitle}>
            Enter the details below
          </Text>

        </View>

      </View>

      {/* FORM */}

      <FlatList
        data={[1]}
        keyExtractor={() => 'form'}
        showsVerticalScrollIndicator={false}
        renderItem={() => (
          <View style={styles.form}>

            {/* ERROR MESSAGE */}

            {error !== '' && (
              <View style={styles.errorBox}>

                <View style={styles.errorCircle}>

                  <Text style={styles.errorCircleText}>
                    !
                  </Text>

                </View>

                <Text style={styles.errorText}>
                  {error}
                </Text>

              </View>
            )}

            {/* DISH NAME */}

            <View style={styles.inputGroup}>

              <Text style={styles.label}>
                Dish Name
              </Text>

              <TextInput
                style={styles.input}
                placeholder="e.g. Chicken Alfredo"
                placeholderTextColor="#999999"
                value={dishName}
                onChangeText={(text) => {
                  setDishName(text);
                  setError('');
                }}
              />

            </View>

            {/* DESCRIPTION */}

            <View style={styles.inputGroup}>

              <Text style={styles.label}>
                Description
              </Text>

              <TextInput
                style={[
                  styles.input,
                  styles.descriptionInput,
                ]}
                placeholder="Describe the dish..."
                placeholderTextColor="#999999"
                value={description}
                onChangeText={(text) => {
                  setDescription(text);
                  setError('');
                }}
                multiline
                numberOfLines={4}
                textAlignVertical="top"
              />

            </View>

            {/* COURSE */}

            <View style={styles.inputGroup}>

              <Text style={styles.label}>
                Course
              </Text>

              <View style={styles.pickerContainer}>

                <Picker
                  selectedValue={course}
                  onValueChange={(itemValue) => {
                    setCourse(itemValue);
                    setError('');
                  }}
                >

                  <Picker.Item
                    label="Select a course"
                    value=""
                  />

                  <Picker.Item
                    label="Starter"
                    value="Starter"
                  />

                  <Picker.Item
                    label="Main Course"
                    value="Main Course"
                  />

                  <Picker.Item
                    label="Dessert"
                    value="Dessert"
                  />

                  <Picker.Item
                    label="Beverage"
                    value="Beverage"
                  />

                </Picker>

              </View>

            </View>

            {/* PRICE */}

            <View style={styles.inputGroup}>

              <Text style={styles.label}>
                Price
              </Text>

              <View style={styles.priceContainer}>

                <Text style={styles.currency}>
                  R
                </Text>

                <TextInput
                  style={styles.priceInput}
                  placeholder="85.00"
                  placeholderTextColor="#999999"
                  value={price}
                  onChangeText={(text) => {
                    setPrice(text);
                    setError('');
                  }}
                  keyboardType="decimal-pad"
                />

              </View>

            </View>

            {/* SAVE */}

            <Pressable
              style={styles.saveButton}
              onPress={addMenuItem}
            >

              <Text style={styles.saveButtonText}>
                SAVE MENU ITEM
              </Text>

            </Pressable>

            {/* CANCEL */}

            <Pressable
              style={styles.cancelButton}
              onPress={() => {
                clearForm();
                setScreen('home');
              }}
            >

              <Text style={styles.cancelButtonText}>
                Cancel
              </Text>

            </Pressable>

          </View>
        )}
      />

    </View>
  );
}

